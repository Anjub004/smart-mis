# ---------------------------------------------------------------------------
# SmartMIS environment configuration
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Runtime environment: development | production | test
SMARTMIS_ENV=development
LOG_LEVEL=INFO
# Optional: override the folder that holds settings.yaml etc.
# SMARTMIS_CONFIG_DIR=./config

# --- Database ---------------------------------------------------------------
# Leave empty to use the local SQLite file at data/smartmis.db
# Examples:
#   postgresql+psycopg://user:password@localhost:5432/smartmis
#   mysql+pymysql://user:password@localhost:3306/smartmis
DATABASE_URL=

# --- Email (SMTP) -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
# Comma-separated default recipients
REPORT_RECIPIENTS=

# --- Google Sheets (optional) ----------------------------------------------
# Path to a service-account JSON key file kept OUTSIDE the repository
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- AI analysis (optional) -------------------------------------------------
# When empty, AI Analysis is disabled and everything else keeps working.
AI_API_KEY=
AI_MODEL=
